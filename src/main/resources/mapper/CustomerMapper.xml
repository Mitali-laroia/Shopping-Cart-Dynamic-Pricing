<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shoppingcart.mapper.CustomerMapper">

    <resultMap id="CustomerResultMap" type="com.example.shoppingcart.model.Customer">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="loyaltyLevel" column="loyalty_level" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="CustomerResultMap">
        SELECT * FROM shopping_cart.customers ORDER BY id
    </select>

    <select id="findById" resultMap="CustomerResultMap">
        SELECT * FROM shopping_cart.customers WHERE id = #{id}
    </select>

    <select id="findByEmail" resultMap="CustomerResultMap">
        SELECT * FROM shopping_cart.customers WHERE email = #{email}
    </select>

    <select id="findByLoyaltyLevel" resultMap="CustomerResultMap">
        SELECT * FROM shopping_cart.customers WHERE loyalty_level = #{loyaltyLevel} ORDER BY id
    </select>

    <insert id="insert" parameterType="com.example.shoppingcart.model.Customer" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO shopping_cart.customers (name, email, loyalty_level, created_at, updated_at)
        VALUES (#{name}, #{email}, #{loyaltyLevel}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="com.example.shoppingcart.model.Customer">
        UPDATE shopping_cart.customers 
        SET name = #{name}, email = #{email}, loyalty_level = #{loyaltyLevel}, updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM shopping_cart.customers WHERE id = #{id}
    </delete>

</mapper>